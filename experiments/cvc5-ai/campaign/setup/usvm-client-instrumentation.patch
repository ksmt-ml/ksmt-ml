@@ -0,0 +1,131 @@
+package org.usvm.dataset
+
+import org.jacodb.api.jvm.JcClassOrInterface
+import org.jacodb.api.jvm.JcMethod
+import org.usvm.CoverageZone
+import org.usvm.PathSelectionStrategy
+import org.usvm.UMachineOptions
+import org.usvm.machine.JcMachine
+import org.usvm.samples.JacoDBContainer
+import org.usvm.samples.samplesWithApproximationsKey
+import org.usvm.solver.ClientStats
+import java.io.File
+import kotlin.time.Duration.Companion.milliseconds
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Experiment driver (not part of upstream USVM): analyses a fixed list of methods and records per-method solver statistics.
+ * Arguments are key=value: project=NAME cp=a.jar:b.jar methods=FILE (one method tag per line, as in the query dataset)
+ * out=FILE.jsonl methodTimeoutMs=N solverTimeoutMs=N totalSeconds=N deadlineEpoch=N rssLimitMb=N.
+ * The solver is chosen by the environment variable USVM_SOLVER (z3 by default, cvc5), statistics need USVM_CLIENT_STATS=1.
+ */
+fun main(args: Array<String>) {
+    org.burningwave.core.assembler.StaticComponentContainer.Modules.exportAllToAll()
+    val a = args.associate { it.substringBefore('=') to it.substringAfter('=') }
+    val project = a.getValue("project")
+    val cpFiles = a.getValue("cp").split(File.pathSeparator).map { File(it) }
+    val tags = File(a.getValue("methods")).readLines().filter { it.isNotBlank() }
+    val out = File(a.getValue("out"))
+    val methodTimeout = (a["methodTimeoutMs"] ?: "10000").toLong()
+    val solverTimeoutMs = (a["solverTimeoutMs"] ?: "3000").toLong()
+    val deadlineEpochMs = a["deadlineEpoch"]?.toLong()?.times(1000)
+        ?: (System.currentTimeMillis() + (a["totalSeconds"] ?: "1500").toLong() * 1000)
+    val rssLimitMb = (a["rssLimitMb"] ?: "2200").toLong()
+    val solverName = System.getenv("USVM_SOLVER") ?: "z3"
+
+    val done: Set<String> = if (out.exists()) {
+        out.readLines().map { it.substringAfter("\"tag\":\"").substringBefore("\",\"solver\"") }.toSet()
+    } else {
+        emptySet()
+    }
+
+    val container = JacoDBContainer(samplesWithApproximationsKey, cpFiles)
+    val cp = container.cp
+    var n = 0
+    for (tag in tags) {
+        if (System.currentTimeMillis() > deadlineEpochMs) {
+            System.err.println("[client] deadline reached")
+            break
+        }
+        if (tag in done) continue
+        val m = findMethod(cp, project, tag)
+        if (m == null) {
+            System.err.println("[client] method not found: $tag")
+            continue
+        }
+        runMethod(project, tag, solverName, m, methodTimeout, solverTimeoutMs, out)
+        n++
+        System.gc()
+        if (rssMb() > rssLimitMb) {
+            System.err.println("[client] RSS limit reached, restart requested")
+            System.exit(3)
+        }
+    }
+    System.err.println("[client] DONE $project solver=$solverName methods=$n")
+    System.exit(0)
+}
+
+private fun findMethod(cp: org.jacodb.api.jvm.JcClasspath, project: String, tag: String): JcMethod? {
+    val rest = tag.removePrefix("$project/")
+    val paren = rest.indexOf('(')
+    val dot = rest.lastIndexOf('.', paren)
+    val className = rest.substring(0, dot)
+    val name = rest.substring(dot + 1, paren)
+    val desc = rest.substring(paren)
+    val jc: JcClassOrInterface = runCatching { cp.findClassOrNull(className) }.getOrNull() ?: return null
+    return jc.declaredMethods.firstOrNull { it.name == name && it.description == desc }
+}
+
+private fun rssMb(): Long =
+    File("/proc/self/status").readLines().first { it.startsWith("VmRSS:") }.split(Regex("\\s+"))[1].toLong() / 1024
+
+private fun runMethod(
+    project: String,
+    tag: String,
+    solverName: String,
+    m: JcMethod,
+    timeoutMs: Long,
+    solverTimeoutMs: Long,
+    out: File,
+) {
+    ClientStats.reset()
+    val options = UMachineOptions(
+        pathSelectionStrategies = listOf(PathSelectionStrategy.FORK_DEPTH),
+        coverageZone = CoverageZone.TRANSITIVE,
+        exceptionsPropagation = true,
+        timeout = timeoutMs.milliseconds,
+        stepsFromLastCovered = 3500L,
+        solverTimeout = solverTimeoutMs.milliseconds,
+        typeOperationsTimeout = 1.seconds,
+    )
+    val os = java.lang.management.ManagementFactory.getOperatingSystemMXBean() as com.sun.management.OperatingSystemMXBean
+    val cpu0 = os.processCpuTime
+    val load1 = File("/proc/loadavg").readText().substringBefore(' ')
+    val t0 = System.nanoTime()
+    var tCtor = 0L
+    var tAnalyze = 0L
+    var status = "ok"
+    var states = 0
+    try {
+        val c0 = System.nanoTime()
+        JcMachine(m.enclosingClass.classpath, options).use { machine ->
+            tCtor = System.nanoTime() - c0
+            val a0 = System.nanoTime()
+            states = machine.analyze(m).size
+            tAnalyze = System.nanoTime() - a0
+        }
+    } catch (e: Throwable) {
+        status = "error:" + e.javaClass.simpleName
+        System.err.println("[client] ERROR in $tag: $e " + e.cause)
+    }
+    val wallMs = (System.nanoTime() - t0) / 1e6
+    val cpuMs = (os.processCpuTime - cpu0) / 1e6
+    val stats = ClientStats.snapshotAndReset()
+    val esc = tag.replace("\\", "\\\\").replace("\"", "\\\"")
+    synchronized(out) {
+        out.appendText(
+            "{\"tag\":\"$esc\",\"solver\":\"$solverName\",\"project\":\"$project\",\"status\":\"$status\",\"states\":$states," +
+                "\"wall_ms\":$wallMs,\"cpu_ms\":$cpuMs,\"load1\":$load1,\"ctor_ms\":${tCtor / 1e6},\"analyze_ms\":${tAnalyze / 1e6},\"stats\":$stats}\n"
+        )
+    }
+}
diff --git a/usvm-jvm/src/test/kotlin/org/usvm/dataset/ModelProbe.kt b/usvm-jvm/src/test/kotlin/org/usvm/dataset/ModelProbe.kt
new file mode 100644
index 00000000..a7c2c376
--- /dev/null
+++ b/usvm-jvm/src/test/kotlin/org/usvm/dataset/ModelProbe.kt
@@ -0,0 +1,111 @@
+@file:Suppress("UNCHECKED_CAST")
+
+package org.usvm.dataset
+
+import io.ksmt.KContext
+import io.ksmt.solver.KSolverStatus
+import io.ksmt.solver.cvc5.KCvc5Solver
+import io.ksmt.solver.z3.KZ3SMTLibParser
+import io.ksmt.solver.z3.KZ3Solver
+import java.io.File
+import java.util.zip.GZIPInputStream
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Minimal harness for the cvc5 model extraction cost: args FILE.smt2.gz SOLVER(cvc5|z3) REPS [what=detach|model|decls|eval|native|none].
+ * Times: parse, assert, check, model(), then the chosen extraction step, several times in one solver.
+ */
+fun main(args: Array<String>) {
+    val file = File(args[0])
+    val solverName = args[1]
+    val reps = args[2].toInt()
+    val what = args.getOrElse(3) { "detach" }
+    val text = (if (file.name.endsWith(".gz")) GZIPInputStream(file.inputStream()) else file.inputStream()).readBytes().decodeToString()
+    KContext().use { ctx ->
+        var t = System.nanoTime()
+        val parsed = KZ3SMTLibParser(ctx).parse(text)
+        // PROBE_ITE=1 applies the table -> ite rewriting (TableIteTransformer) before asserting
+        val asserts = if (System.getenv("PROBE_ITE") == "1") {
+            val tr = org.usvm.solver.TableIteTransformer(ctx)
+            parsed.map { tr.apply(it) }.also { println("table reads rewritten=${tr.rewritten}") }
+        } else {
+            parsed
+        }
+        println("parse ms=${(System.nanoTime() - t) / 1e6} asserts=${asserts.size}")
+        if (what == "bisect") {
+            // leave one assertion out at a time and time the first getValue after check-sat
+            for (k in asserts.indices) {
+                val sub = asserts.filterIndexed { j, _ -> j != k }
+                KCvc5Solver(ctx).use { c ->
+                    c.assert(sub)
+                    val st0 = c.check(10.seconds)
+                    val t1 = System.nanoTime()
+                    if (st0 == KSolverStatus.SAT) c.model().detach()
+                    println("   without assert $k: $st0 detach ms=${(System.nanoTime() - t1) / 1e6}")
+                }
+            }
+            return
+        }
+        val s: io.ksmt.solver.KSolver<*> = if (solverName == "cvc5") KCvc5Solver(ctx).also { c ->
+            // PROBE_OPTS="name=value,name=value" native cvc5 options applied before the first assertion
+            System.getenv("PROBE_OPTS")?.split(",")?.filter { it.isNotBlank() }?.forEach { c.nativeSolver().setOption(it.substringBefore('='), it.substringAfter('=')) }
+        } else KZ3Solver(ctx)
+        t = System.nanoTime()
+        s.assert(asserts)
+        println("assert ms=${(System.nanoTime() - t) / 1e6}")
+        t = System.nanoTime()
+        val st = s.check(10.seconds)
+        println("check $st ms=${(System.nanoTime() - t) / 1e6}")
+        if (st != KSolverStatus.SAT) return
+        repeat(reps) { i ->
+            t = System.nanoTime()
+            val m = s.model()
+            val tModel = (System.nanoTime() - t) / 1e6
+            t = System.nanoTime()
+            var info = ""
+            when (what) {
+                "detach" -> m.detach()
+                "decls" -> info = "decls=${m.declarations.size}"
+                "eval" -> {
+                    // evaluate only the constants that occur in the assertions
+                    var n = 0
+                    for (d in m.declarations) { if (d.argSorts.isEmpty()) { m.eval(ctx.mkApp(d, emptyList()), true); n++ } }
+                    info = "evaluated=$n"
+                }
+                "evalasserts" -> {
+                    // lazy alternative: evaluate only the terms the engine needs (here: every assertion)
+                    for ((k, a) in asserts.withIndex()) {
+                        val t1 = System.nanoTime()
+                        val v = m.eval(a, true)
+                        println("   assert $k -> $v".take(60) + " ms=${(System.nanoTime() - t1) / 1e6}")
+                    }
+                }
+                "evalselect" -> {
+                    // evaluate select(length, x) for each address constant instead of the whole array
+                    val len = m.declarations.first { it.name.startsWith("length<") }
+                    val lenExpr = ctx.mkApp(len, emptyList()) as io.ksmt.expr.KExpr<io.ksmt.sort.KArraySort<io.ksmt.sort.KUninterpretedSort, io.ksmt.sort.KBv32Sort>>
+                    for (d in m.declarations.filter { it.sort is io.ksmt.sort.KUninterpretedSort && it.argSorts.isEmpty() }) {
+                        val t1 = System.nanoTime()
+                        val idx = ctx.mkApp(d, emptyList()) as io.ksmt.expr.KExpr<io.ksmt.sort.KUninterpretedSort>
+                        val v = m.eval(ctx.mkArraySelect(lenExpr, idx), true)
+                        println("   select(length, ${d.name}) = $v ms=${(System.nanoTime() - t1) / 1e6}")
+                    }
+                }
+                "perdecl" -> {
+                    for (d in m.declarations) {
+                        val t1 = System.nanoTime()
+                        m.interpretation(d)
+                        println("   decl ${d.name.take(60)} : ${d.sort.toString().take(80)} ms=${(System.nanoTime() - t1) / 1e6}")
+                    }
+                }
+                "native" -> {
+                    val ns = (s as KCvc5Solver).nativeSolver()
+                    val n = ns.getAssertions().size
+                    info = "nativeAssertions=$n"
+                }
+                else -> {}
+            }
+            println("rep $i model() ms=$tModel step($what) ms=${(System.nanoTime() - t) / 1e6} $info")
+        }
+    }
+}
diff --git a/usvm-jvm/src/test/kotlin/org/usvm/dataset/ReplayDriver.kt b/usvm-jvm/src/test/kotlin/org/usvm/dataset/ReplayDriver.kt
new file mode 100644
index 00000000..cb15ac93
--- /dev/null
+++ b/usvm-jvm/src/test/kotlin/org/usvm/dataset/ReplayDriver.kt
@@ -0,0 +1,222 @@
+package org.usvm.dataset
+
+import io.ksmt.KContext
+import io.ksmt.expr.KExpr
+import io.ksmt.solver.KSolver
+import io.ksmt.solver.KSolverConfiguration
+import io.ksmt.solver.KSolverStatus
+import io.ksmt.solver.cvc5.KCvc5Solver
+import io.ksmt.solver.z3.KZ3SMTLibParser
+import io.ksmt.solver.z3.KZ3Solver
+import io.ksmt.sort.KBoolSort
+import java.io.File
+import java.util.zip.GZIPInputStream
+import kotlin.time.Duration.Companion.milliseconds
+
+/**
+ * Experiment driver (not part of upstream USVM): replays the recorded solver checks of each method in order against a KSMT solver.
+ * Arguments are key=value: queries=DIR (unpacked dataset directory of the project, contains queries.jsonl and the method dirs)
+ * methods=FILE (tags, one per line) out=FILE.jsonl solver=cvc5|z3 timeoutMs=N warmup=N modes=fresh,usvm,incr
+ *   fresh: new solver for every check
+ *   usvm:  one solver per method, push, assert everything, check, pop (what USVM does today)
+ *   incr:  one solver per method, one scope per assertion, pop to the common prefix with the previous check and assert only the new suffix
+ * Every successful check is followed by model().detach() as in USVM.
+ */
+fun main(args: Array<String>) {
+    val a = args.associate { it.substringBefore('=') to it.substringAfter('=') }
+    val dir = File(a.getValue("queries"))
+    val tags = File(a.getValue("methods")).readLines().filter { it.isNotBlank() }.toSet()
+    val out = File(a.getValue("out"))
+    val solverName = a["solver"] ?: "cvc5"
+    val timeoutMs = (a["timeoutMs"] ?: "3000").toLong()
+    val warmup = (a["warmup"] ?: "3").toInt()
+    val modes = (a["modes"] ?: "fresh,usvm,incr").split(",")
+    // finished (method, query) pairs: the run is resumable at query level
+    val done = HashMap<String, MutableSet<Int>>()
+    if (out.exists()) {
+        out.forEachLine { l ->
+            done.getOrPut(l.substringAfter("\"tag\":\"").substringBefore("\",\"qid\"")) { HashSet() }
+                .add(l.substringAfter("\"qid\":").substringBefore(",").toInt())
+        }
+    }
+
+    val byTag = LinkedHashMap<String, MutableList<Pair<Int, String>>>()
+    dir.resolve("queries.jsonl").forEachLine { line ->
+        val tag = line.substringAfter("\"tag\": \"").substringBefore("\", \"qid\"")
+        val unesc = tag.replace("\\\"", "\"").replace("\\\\", "\\")
+        if (unesc in tags) {
+            val qid = line.substringAfter("\"qid\": ").substringBefore(",").toInt()
+            val file = line.substringAfter("\"file\": \"").substringBefore("\"")
+            byTag.getOrPut(unesc) { ArrayList() }.add(qid to file)
+        }
+    }
+    val order = tags.filter { it in byTag }
+    println("[replay] methods=${order.size} solver=$solverName modes=$modes")
+    val rssLimitMb = (a["rssLimitMb"] ?: "2200").toLong()
+    var warmed = warmup == 0
+    for (tag in order) {
+        val esc = tag.replace("\\", "\\\\").replace("\"", "\\\"")
+        val skip = done[esc] ?: emptySet<Int>()
+        val queries = byTag.getValue(tag).sortedBy { it.first }.filter { it.first !in skip }
+        if (queries.isEmpty()) continue
+        if (!warmed) {
+            // JIT and native library warm-up on the first queries of the first method, results are discarded
+            replayMethod(dir, queries.take(warmup), solverName, timeoutMs, modes) { }
+            warmed = true
+        }
+        replayMethod(dir, queries, solverName, timeoutMs, modes) { r ->
+            out.appendText("{\"tag\":\"$esc\"," + r + "}\n")
+            if (rssMb() > rssLimitMb) {
+                println("[replay] RSS limit reached, restart requested")
+                System.exit(3)
+            }
+        }
+        System.gc()
+    }
+    println("[replay] DONE")
+    System.exit(0)
+}
+
+private fun rssMb(): Long =
+    File("/proc/self/status").readLines().first { it.startsWith("VmRSS:") }.split(Regex("\\s+"))[1].toLong() / 1024
+
+@Suppress("UNCHECKED_CAST")
+private fun mk(name: String, ctx: KContext): KSolver<KSolverConfiguration> = when (name) {
+    "cvc5" -> KCvc5Solver(ctx).also { s ->
+        // REPLAY_LOGIC (e.g. QF_AUFBVFPLIA) makes cvc5 use a concrete logic instead of ALL; REPLAY_CVC5_OPTS="name=value,name=value" sets native options
+        System.getenv("REPLAY_LOGIC")?.takeIf { it.isNotBlank() }?.let { s.nativeSolver().setLogic(it) }
+        System.getenv("REPLAY_CVC5_OPTS")?.split(",")?.filter { it.isNotBlank() }?.forEach {
+            s.nativeSolver().setOption(it.substringBefore('='), it.substringAfter('='))
+        }
+    } as KSolver<KSolverConfiguration>
+    else -> KZ3Solver(ctx) as KSolver<KSolverConfiguration>
+}
+
+private class Timing {
+    var create = 0L
+    var assertN = 0L
+    var check = 0L
+    var model = 0L
+    var pushPop = 0L
+    var status = "X"
+    private val tmx = java.lang.management.ManagementFactory.getThreadMXBean()
+    private val cpu0 = tmx.currentThreadCpuTime
+    fun total() = create + assertN + check + model + pushPop
+    /** [wall total, create, assert, check, model, push/pop, thread CPU time of the whole block], microseconds. */
+    fun json(prefix: String) =
+        "\"${prefix}\":[${total() / 1000},${create / 1000},${assertN / 1000},${check / 1000},${model / 1000},${pushPop / 1000},${(tmx.currentThreadCpuTime - cpu0) / 1000}],\"${prefix}s\":\"$status\""
+}
+
+private fun checkAndModel(s: KSolver<KSolverConfiguration>, t: Timing, timeoutMs: Long) {
+    val c0 = System.nanoTime()
+    val st = s.check(timeoutMs.milliseconds)
+    t.check += System.nanoTime() - c0
+    t.status = when (st) { KSolverStatus.SAT -> "S"; KSolverStatus.UNSAT -> "U"; else -> "?" }
+    if (st == KSolverStatus.SAT) {
+        val m0 = System.nanoTime()
+        s.model().detach()
+        t.model += System.nanoTime() - m0
+    }
+}
+
+private fun replayMethod(
+    dir: File,
+    queries: List<Pair<Int, String>>,
+    solverName: String,
+    timeoutMs: Long,
+    modes: List<String>,
+    emit: (String) -> Unit,
+) {
+    KContext().use { ctx ->
+        val parser = KZ3SMTLibParser(ctx)
+        val parsed = queries.map { (qid, file) ->
+            val text = GZIPInputStream(dir.resolve(file).inputStream()).readBytes().decodeToString()
+            qid to runCatching { parser.parse(text) }.getOrNull()
+        }
+        var usvmSolver: KSolver<KSolverConfiguration>? = if ("usvm" in modes) mk(solverName, ctx) else null
+        var incrSolver: KSolver<KSolverConfiguration>? = if ("incr" in modes) mk(solverName, ctx) else null
+        var incrStack = ArrayList<KExpr<KBoolSort>>()
+        var incrDepth = 0
+        try {
+            for ((qid, exprs) in parsed) {
+                if (exprs == null) {
+                    emit("\"qid\":$qid,\"err\":1")
+                    // the incremental stack is no longer valid for the next query
+                    continue
+                }
+                val sb = StringBuilder("\"qid\":$qid,\"n\":${exprs.size}")
+                try {
+                // "fresh2" repeats the fresh mode once more to measure run-to-run variation
+                for (fm in listOf("fresh" to "f", "fresh2" to "g")) {
+                    if (fm.first !in modes) continue
+                    val t = Timing()
+                    val c0 = System.nanoTime()
+                    val s = mk(solverName, ctx)
+                    t.create += System.nanoTime() - c0
+                    try {
+                        val a0 = System.nanoTime()
+                        s.assert(exprs)
+                        t.assertN += System.nanoTime() - a0
+                        checkAndModel(s, t, timeoutMs)
+                    } finally {
+                        val d0 = System.nanoTime()
+                        s.close()
+                        t.create += System.nanoTime() - d0
+                    }
+                    sb.append(",").append(t.json(fm.second))
+                }
+                if (usvmSolver != null) {
+                    val s = usvmSolver
+                    val t = Timing()
+                    val p0 = System.nanoTime()
+                    s.push()
+                    t.pushPop += System.nanoTime() - p0
+                    val a0 = System.nanoTime()
+                    s.assert(exprs)
+                    t.assertN += System.nanoTime() - a0
+                    checkAndModel(s, t, timeoutMs)
+                    val q0 = System.nanoTime()
+                    s.pop()
+                    t.pushPop += System.nanoTime() - q0
+                    sb.append(",").append(t.json("u"))
+                }
+                if (incrSolver != null) {
+                    val s = incrSolver
+                    val t = Timing()
+                    var k = 0
+                    while (k < exprs.size && k < incrStack.size && exprs[k] == incrStack[k]) k++
+                    val p0 = System.nanoTime()
+                    if (incrStack.size > k) {
+                        s.pop((incrStack.size - k).toUInt())
+                        while (incrStack.size > k) incrStack.removeAt(incrStack.size - 1)
+                    }
+                    t.pushPop += System.nanoTime() - p0
+                    for (j in k until exprs.size) {
+                        val q0 = System.nanoTime()
+                        s.push()
+                        t.pushPop += System.nanoTime() - q0
+                        val a0 = System.nanoTime()
+                        s.assert(exprs[j])
+                        t.assertN += System.nanoTime() - a0
+                        incrStack += exprs[j]
+                    }
+                    checkAndModel(s, t, timeoutMs)
+                    sb.append(",").append(t.json("i")).append(",\"ik\":$k")
+                }
+                emit(sb.toString())
+                } catch (e: Throwable) {
+                    // e.g. KSolverUnsupportedFeatureException (fp.to_ieee_bv): record the failure and restart the persistent solvers
+                    emit("\"qid\":$qid,\"err\":2,\"msg\":\"${e.javaClass.simpleName}\"")
+                    runCatching { usvmSolver?.close() }
+                    runCatching { incrSolver?.close() }
+                    usvmSolver = if ("usvm" in modes) mk(solverName, ctx) else null
+                    incrSolver = if ("incr" in modes) mk(solverName, ctx) else null
+                    incrStack = ArrayList()
+                }
+            }
+        } finally {
+            usvmSolver?.close()
+            incrSolver?.close()
+        }
+    }
+}
