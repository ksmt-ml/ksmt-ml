{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksmt.io/schemas/cvc5-grouped-confirmation-summary-v0.schema.json",
  "title": "Grouped paired cvc5 confirmation summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "scheduleSha256", "scoreAggregation", "bootstrapSeed", "results"
  ],
  "properties": {
    "schemaVersion": { "const": "cvc5-grouped-confirmation-summary-v0" },
    "scheduleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scoreAggregation": {
      "enum": [
        "workload-macro-mean-log-speedup-v0",
        "workload-total-effective-cost-log-speedup-v0"
      ]
    },
    "bootstrapSeed": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "candidateId", "defaultControl", "eligible", "workloadGroupCount",
          "pairedRepetitionCount", "meanLogSpeedup", "medianLogSpeedup",
          "geometricSpeedup", "relativeImprovement", "positiveGroupCount",
          "bootstrap95MeanLogSpeedup", "groupRewards"
        ],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "defaultControl": { "type": "boolean" },
          "eligible": { "type": "boolean" },
          "workloadGroupCount": { "type": "integer", "minimum": 1 },
          "pairedRepetitionCount": { "type": "integer", "minimum": 1 },
          "meanLogSpeedup": { "type": "number" },
          "medianLogSpeedup": { "type": "number" },
          "geometricSpeedup": { "type": "number", "exclusiveMinimum": 0 },
          "relativeImprovement": { "type": "number" },
          "positiveGroupCount": { "type": "integer", "minimum": 0 },
          "bootstrap95MeanLogSpeedup": {
            "type": "object", "additionalProperties": false,
            "required": ["low", "high"],
            "properties": {
              "low": { "type": "number" },
              "high": { "type": "number" }
            }
          },
          "groupRewards": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["workloadGroupId", "medianLogSpeedup", "repetitions"],
              "properties": {
                "workloadGroupId": { "type": "string", "minLength": 1 },
                "medianLogSpeedup": { "type": "number" },
                "repetitions": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
