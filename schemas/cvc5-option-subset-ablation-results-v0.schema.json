{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksmt.io/schemas/cvc5-option-subset-ablation-results-v0.schema.json",
  "title": "cvc5 option-subset ablation results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sourceCandidateId", "baselineManifest", "workloadSha256",
    "repetitions", "warmups", "selection", "complete", "results"
  ],
  "properties": {
    "schemaVersion": { "const": "cvc5-option-subset-ablation-results-v0" },
    "sourceCandidateId": { "type": "string", "minLength": 1 },
    "baselineManifest": { "$ref": "#/$defs/fileBinding" },
    "workloadSha256": { "$ref": "#/$defs/sha256" },
    "repetitions": { "type": "integer", "minimum": 1 },
    "warmups": { "type": "integer", "minimum": 0 },
    "selection": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "all-subsets-v0" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "sourceFileName", "sourceSha256", "selectedMasks"],
          "properties": {
            "kind": { "const": "eligible-from-results-v0" },
            "sourceFileName": { "type": "string", "minLength": 1 },
            "sourceSha256": { "$ref": "#/$defs/sha256" },
            "selectedMasks": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ]
    },
    "complete": { "type": "boolean" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinal", "mask", "optionNames", "candidateId", "eligible", "reward",
        "geometricSpeedup", "speedupVsFreshDefault", "wrongAnswerCount",
        "knownStatusTimeoutCount", "failedReplayCount", "reportSha256", "scoreSha256"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "mask": { "type": "integer", "minimum": 0 },
        "optionNames": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "candidateId": { "type": "string", "minLength": 1 },
        "eligible": { "type": "boolean" },
        "reward": { "type": "number" },
        "geometricSpeedup": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "speedupVsFreshDefault": {
          "type": ["number", "null"], "exclusiveMinimum": 0
        },
        "wrongAnswerCount": { "type": "integer", "minimum": 0 },
        "knownStatusTimeoutCount": { "type": "integer", "minimum": 0 },
        "failedReplayCount": { "type": "integer", "minimum": 0 },
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "scoreSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
