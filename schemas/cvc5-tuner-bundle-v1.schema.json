{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksmt.io/schemas/cvc5-tuner-bundle-v1.schema.json",
  "title": "KSMT cvc5 tuner model bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleId",
    "bundleSchemaVersion",
    "modelId",
    "profileSchemaVersion",
    "featureSchemaId",
    "parameterSpaceId",
    "targetSolver",
    "compatibleSolverVersions",
    "applicationLifecycle",
    "input",
    "output",
    "checksums"
  ],
  "properties": {
    "bundleSchemaVersion": { "const": "cvc5-tuner-bundle-v1" },
    "bundleId": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "profileSchemaVersion": { "type": "string", "minLength": 1 },
    "featureSchemaId": { "type": "string", "minLength": 1 },
    "parameterSpaceId": { "type": "string", "minLength": 1 },
    "targetSolver": { "const": "cvc5" },
    "applicationLifecycle": { "const": "fresh-solver" },
    "compatibleSolverVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "input": { "$ref": "#/$defs/tensor" },
    "output": { "$ref": "#/$defs/tensor" },
    "checksums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "elementType", "dimensions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "elementType": { "enum": ["float32", "float64", "int64"] },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
