{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksmt.io/schemas/cvc5-default-noise-calibration-summary-v0.schema.json",
  "title": "Balanced default/default cvc5 noise calibration summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "scheduleSha256", "candidateId", "workloadGroupIds",
    "pairedRepetitionCount", "bootstrapSeed",
    "targetMinimumRelativeImprovement", "scoreAggregation",
    "targetLogSpeedup", "thresholds",
    "correctness", "metrics", "gate"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cvc5-default-noise-calibration-summary-v0"
    },
    "scheduleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateId": { "type": "string", "minLength": 1 },
    "workloadGroupIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pairedRepetitionCount": { "type": "integer", "minimum": 2 },
    "bootstrapSeed": { "type": "integer", "minimum": 0 },
    "targetMinimumRelativeImprovement": {
      "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1
    },
    "scoreAggregation": {
      "enum": [
        "workload-macro-mean-log-speedup-v0",
        "workload-total-effective-cost-log-speedup-v0"
      ]
    },
    "targetLogSpeedup": { "type": "number", "exclusiveMinimum": 0 },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimumPairedRepetitionsPerGroup", "maxAbsoluteMedianLogSpeedup",
        "maxBootstrap95IntervalWidth", "requireIntervalContainsZero"
      ],
      "properties": {
        "minimumPairedRepetitionsPerGroup": {
          "type": "integer", "minimum": 2
        },
        "maxAbsoluteMedianLogSpeedup": { "type": "number", "minimum": 0 },
        "maxBootstrap95IntervalWidth": { "type": "number", "minimum": 0 },
        "requireIntervalContainsZero": { "const": true }
      }
    },
    "correctness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "allPairsEligible", "wrongAnswerCount", "timeoutCount",
        "failureCount", "passed"
      ],
      "properties": {
        "allPairsEligible": { "type": "boolean" },
        "wrongAnswerCount": { "type": "integer", "minimum": 0 },
        "timeoutCount": { "type": "integer", "minimum": 0 },
        "failureCount": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "replayProxyLogSpeedup", "solverOperationLogSpeedup", "wallLogSpeedup"
      ],
      "properties": {
        "replayProxyLogSpeedup": { "$ref": "#/$defs/noiseMetric" },
        "solverOperationLogSpeedup": { "$ref": "#/$defs/noiseMetric" },
        "wallLogSpeedup": { "$ref": "#/$defs/noiseMetric" }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "failedChecks"],
      "properties": {
        "passed": { "type": "boolean" },
        "failedChecks": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "noiseMetric": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pairedValues", "meanLogSpeedup", "medianLogSpeedup",
        "geometricSpeedup", "sampleStandardDeviation",
        "medianAbsoluteDeviation", "bootstrap95MeanLogSpeedup",
        "intervalWidth", "intervalContainsZero",
        "absoluteMedianLogSpeedup", "passesGate"
      ],
      "properties": {
        "pairedValues": {
          "type": "array", "minItems": 2,
          "items": { "type": "number" }
        },
        "meanLogSpeedup": { "type": "number" },
        "medianLogSpeedup": { "type": "number" },
        "geometricSpeedup": { "type": "number", "exclusiveMinimum": 0 },
        "sampleStandardDeviation": { "type": "number", "minimum": 0 },
        "medianAbsoluteDeviation": { "type": "number", "minimum": 0 },
        "bootstrap95MeanLogSpeedup": { "$ref": "#/$defs/interval" },
        "intervalWidth": { "type": "number", "minimum": 0 },
        "intervalContainsZero": { "type": "boolean" },
        "absoluteMedianLogSpeedup": { "type": "number", "minimum": 0 },
        "passesGate": { "type": "boolean" }
      }
    }
  }
}
